{
  "name": "markdown-to-html-api",
  "version": "1.0.0",
  "description": "REST API rápida para convertir Markdown a HTML sanitizado, con soporte de temas y caché en memoria.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\""
  },
  "keywords": [
    "markdown",
    "html",
    "api",
    "rest",
    "fastify",
    "marked",
    "dompurify",
    "sanitize"
  ],
  "author": "Edward Itriago <edwarditriagosub@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "fastify": "^4.28.0",
    "marked": "^14.0.0",
    "marked-highlight": "^2.1.4",
    "highlight.js": "^11.10.0",
    "isomorphic-dompurify": "^2.16.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/sensible": "^5.6.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3"
  }
}
